# Copy to .env; credentials may also be entered in the local settings UI.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBED_MODEL=bge-m3
# Start with dense retrieval; enable only after installing GPU reranking dependencies.
BGE_HYBRID_ENABLED=0
